/* ============================================================
   Liga Amateur — Design system (oscuro deportivo, mobile-first)
   ============================================================ */

:root {
  --bg: #0a0f14;
  --surface: #10161d;
  --surface-2: #161f29;
  --border: #223041;
  --border-strong: #31465e;
  --text: #e8eef4;
  --muted: #8fa3b8;
  --faint: #5c7189;
  --accent: #22c55e;
  --accent-soft: rgba(34, 197, 94, 0.14);
  --accent-strong: #16a34a;
  --danger: #ef4444;
  --danger-soft: rgba(239, 68, 68, 0.14);
  --warning: #f59e0b;
  --warning-soft: rgba(245, 158, 11, 0.14);
  --radius: 14px;
  --radius-sm: 10px;
  --radius-xs: 7px;
  --font-head: 'Archivo Black', 'Arial Black', sans-serif;
  --font-body: Inter, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
}

/* ---------- Reset + base ---------- */

* { margin: 0; padding: 0; box-sizing: border-box; }

html { color-scheme: dark; }

body {
  background: var(--bg);
  background-image: radial-gradient(1200px 500px at 50% -10%, rgba(34, 197, 94, 0.07), transparent 60%);
  color: var(--text);
  font-family: var(--font-body);
  font-size: 15.5px;
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
}

.container { max-width: 1040px; margin: 0 auto; padding: 0 16px; }

a { color: var(--accent); text-decoration: none; }
a:hover { text-decoration: underline; }

::selection { background: var(--accent-soft); }

h1, h2, h3 { font-family: var(--font-head); line-height: 1.1; letter-spacing: 0.2px; }

img { max-width: 100%; }

:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

/* ---------- Header ---------- */

.site-header {
  position: sticky;
  top: 0;
  z-index: 50;
  background: rgba(10, 15, 20, 0.92);
  backdrop-filter: blur(10px);
  border-bottom: 1px solid var(--border);
}

.site-header .container { display: flex; align-items: center; gap: 14px; height: 58px; }

.brand {
  display: flex; align-items: center; gap: 10px;
  font-family: var(--font-head);
  font-size: 1.05rem;
  color: var(--text) !important;
  white-space: nowrap;
}
.brand:hover { text-decoration: none; }

.brand-logo {
  width: 34px; height: 34px;
  border-radius: 9px;
  background: var(--accent);
  color: #04120a;
  display: grid; place-items: center;
  font-size: 0.9rem;
  flex: none;
}

.nav { display: flex; gap: 4px; margin-left: auto; overflow-x: auto; scrollbar-width: none; }
.nav::-webkit-scrollbar { display: none; }

.nav a {
  padding: 7px 12px;
  border-radius: 999px;
  color: var(--muted) !important;
  font-size: 0.9rem;
  white-space: nowrap;
}
.nav a:hover { color: var(--text) !important; background: var(--surface-2); text-decoration: none; }
.nav a.active { color: var(--text) !important; background: var(--accent-soft); }

/* ---------- Footer ---------- */

.site-footer {
  margin-top: 40px;
  border-top: 1px solid var(--border);
  padding: 22px 0 90px;
  color: var(--faint);
  font-size: 0.85rem;
}

.site-footer a { color: var(--muted); }

/* ---------- Hero ---------- */

.hero { padding: 30px 0 6px; }

.hero-kicker {
  color: var(--accent);
  font-weight: 700;
  font-size: 0.8rem;
  letter-spacing: 2px;
  text-transform: uppercase;
}

.hero h1 { font-size: clamp(1.7rem, 6vw, 2.6rem); margin: 4px 0 6px; }

.hero-sub { color: var(--muted); max-width: 560px; }

/* ---------- Cards & sections ---------- */

.card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  overflow: hidden;
}

.card-head {
  display: flex; align-items: center; justify-content: space-between; gap: 10px;
  padding: 14px 16px;
  border-bottom: 1px solid var(--border);
}

.card-head h2 { font-size: 1.02rem; letter-spacing: 0.3px; }
.card-head .muted { font-size: 0.85rem; }

.card-body { padding: 16px; }
.card-body > * + * { margin-top: 12px; }

section.block { margin-top: 26px; }

section.block > .card-head h2 a { color: var(--text); }
section.block > .card-head h2 a:hover { color: var(--accent); }

/* ---------- Tables ---------- */

.table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }

table.data { width: 100%; border-collapse: collapse; font-size: 0.9rem; min-width: 520px; }

table.data th {
  text-align: left;
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: var(--faint);
  font-weight: 700;
  padding: 10px 8px;
  border-bottom: 1px solid var(--border-strong);
  white-space: nowrap;
}

table.data td {
  padding: 9px 8px;
  border-bottom: 1px solid var(--border);
  vertical-align: middle;
}

table.data tbody tr:hover { background: var(--surface-2); }
table.data tbody tr:last-child td { border-bottom: none; }

td.num, th.num { text-align: center; width: 34px; }
td.r { text-align: right; white-space: nowrap; }

.pos-num { color: var(--faint); font-weight: 700; font-size: 0.8rem; width: 26px; }

.team-cell { display: flex; align-items: center; gap: 8px; min-width: 0; }

.crest {
  width: 24px; height: 24px;
  border-radius: 6px;
  display: grid; place-items: center;
  font-size: 0.62rem;
  font-weight: 800;
  color: #fff;
  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
  flex: none;
  letter-spacing: 0.5px;
}

.crest.lg { width: 42px; height: 42px; border-radius: 10px; font-size: 0.95rem; }
.crest.sm { width: 20px; height: 20px; border-radius: 5px; font-size: 0.55rem; }

.crest img { width: 100%; height: 100%; object-fit: cover; border-radius: inherit; }

/* ---------- Zonas / fixtures ---------- */

.zone-title { font-family: var(--font-head); font-size: 1rem; margin: 18px 0 8px; }
.zone-title:first-child { margin-top: 0; }

.match-row {
  display: flex; align-items: center; gap: 10px;
  padding: 10px 16px;
  border-bottom: 1px solid var(--border);
}
.match-row:last-child { border-bottom: none; }

.match-row .team-cell { flex: 1; }
.match-row .team-cell.away { justify-content: flex-end; }

.match-center { text-align: center; min-width: 92px; flex: none; }

.score { font-family: var(--font-head); font-size: 1.15rem; letter-spacing: 2px; }

.score-time {
  display: block;
  font-size: 0.68rem;
  line-height: 1.2;
  color: var(--faint);
  margin-top: 1px;
  letter-spacing: 1px;
}

.status-tag {
  display: inline-block;
  font-size: 0.66rem;
  font-weight: 700;
  letter-spacing: 1px;
  text-transform: uppercase;
  padding: 3px 8px;
  border-radius: 999px;
  background: var(--surface-2);
  border: 1px solid var(--border);
  color: var(--muted);
}

.status-tag.scheduled { color: var(--warning); border-color: rgba(245, 158, 11, 0.35); background: var(--warning-soft); }
.status-tag.postponed { color: var(--warning); border-color: rgba(245, 158, 11, 0.35); background: var(--warning-soft); }
.status-tag.suspended { color: var(--danger); border-color: rgba(239, 68, 68, 0.35); background: var(--danger-soft); }
.status-tag.walkover { color: var(--warning); border-color: rgba(245, 158, 11, 0.35); background: var(--warning-soft); }
.status-tag.played { color: var(--muted); }

/* ---------- Bracket ---------- */

.bracket { display: flex; gap: 22px; overflow-x: auto; padding: 18px 16px; -webkit-overflow-scrolling: touch; }

.bracket-col { min-width: 240px; }

.bracket-col h3 {
  font-size: 0.8rem;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 10px;
}

.bracket-col .match-row { border: 1px solid var(--border); border-radius: 10px; padding: 10px 12px; }
.bracket-col .match-row + .match-row { margin-top: 30px; }

.match-row .placeholder { color: var(--faint); font-style: italic; font-weight: 400; }

/* ---------- Badges ---------- */

.badge {
  display: inline-block;
  padding: 2px 9px;
  border-radius: 999px;
  font-size: 0.68rem;
  font-weight: 800;
  letter-spacing: 0.8px;
  text-transform: uppercase;
}

.badge.green { background: var(--accent-soft); color: var(--accent); border: 1px solid rgba(34, 197, 94, 0.35); }
.badge.red { background: var(--danger-soft); color: var(--danger); border: 1px solid rgba(239, 68, 68, 0.35); }
.badge.amber { background: var(--warning-soft); color: var(--warning); border: 1px solid rgba(245, 158, 11, 0.35); }
.badge.ghost { background: var(--surface-2); color: var(--muted); border: 1px solid var(--border); }

/* ---------- Player rows ---------- */

.avatar {
  width: 28px; height: 28px;
  border-radius: 50%;
  background: var(--surface-2);
  display: grid; place-items: center;
  font-size: 0.68rem;
  color: var(--muted);
  flex: none;
}

.avatar.lg { width: 48px; height: 48px; font-size: 1rem; border-radius: 14px; }
.avatar.sm { width: 24px; height: 24px; font-size: 0.6rem; }

/* ---------- Forms & admin ---------- */

.field { margin-bottom: 14px; }

.field label {
  display: block;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.8px;
  text-transform: uppercase;
  color: var(--faint);
  margin-bottom: 6px;
}

input[type=text], input[type=number], input[type=password], input[type=date], input[type=time],
input[type=email], input[type=url], select, textarea {
  width: 100%;
  padding: 10px 12px;
  background: var(--surface-2);
  border: 1px solid var(--border-strong);
  border-radius: var(--radius-xs);
  color: var(--text);
  font: inherit;
  font-size: 0.95rem;
}

input:focus, select:focus, textarea:focus {
  outline: none;
  border-color: var(--accent);
  box-shadow: 0 0 0 3px var(--accent-soft);
}

textarea { min-height: 90px; resize: vertical; }

select {
  appearance: none;
  background-image:
    linear-gradient(45deg, transparent 50%, var(--muted) 50%),
    linear-gradient(135deg, var(--muted) 50%, transparent 50%);
  background-position: calc(100% - 18px) 50%, calc(100% - 13px) 50%;
  background-size: 5px 5px;
  background-repeat: no-repeat;
  padding-right: 34px;
}

.form-row { display: flex; gap: 12px; flex-wrap: wrap; }
.form-row > .field { flex: 1; min-width: 130px; }

.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 7px;
  padding: 10px 18px;
  border-radius: 10px;
  border: 1px solid transparent;
  font-weight: 700;
  font-size: 0.9rem;
  cursor: pointer;
  text-decoration: none !important;
  font-family: var(--font-body);
  transition: filter 0.15s ease, transform 0.05s ease;
}

.btn:active { transform: translateY(1px); }

.btn-primary { background: var(--accent); color: #04120a; }
.btn-primary:hover { filter: brightness(1.08); }

.btn-ghost { background: var(--surface-2); border-color: var(--border-strong); color: var(--text); }
.btn-ghost:hover { background: var(--border); }

.btn-danger { background: var(--danger); color: #fff; }
.btn-danger:hover { filter: brightness(1.1); }

.btn-sm { padding: 6px 12px; font-size: 0.8rem; border-radius: 8px; }

.btn[disabled] { opacity: 0.5; cursor: not-allowed; }

.actions-cell { white-space: nowrap; text-align: right; }

.form-card { max-width: 640px; }

.hint { color: var(--faint); font-size: 0.8rem; margin-top: 4px; }

.error-box {
  background: var(--danger-soft);
  border: 1px solid rgba(239, 68, 68, 0.35);
  color: #fda4af;
  padding: 10px 14px;
  border-radius: var(--radius-xs);
  margin-bottom: 14px;
  font-size: 0.9rem;
}

.success-box {
  background: var(--accent-soft);
  border: 1px solid rgba(34, 197, 94, 0.35);
  color: #86efac;
  padding: 10px 14px;
  border-radius: var(--radius-xs);
  margin-bottom: 14px;
  font-size: 0.9rem;
}

/* ---------- Grids ---------- */

.grid-2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px; }

.grid-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px; }

.team-card {
  display: flex; align-items: center; gap: 12px;
  padding: 14px;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  background: var(--surface);
  color: var(--text) !important;
}

.team-card:hover { border-color: var(--border-strong); text-decoration: none; transform: translateY(-1px); }

.team-card .crest { width: 40px; height: 40px; border-radius: 10px; font-size: 0.9rem; }

.team-card .meta { min-width: 0; }
.team-card .meta .name { font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.team-card .meta .sub { font-size: 0.8rem; color: var(--faint); }

/* ---------- Event list (ficha de partido) ---------- */

.event-row {
  display: flex; align-items: center; gap: 8px;
  padding: 7px 0;
  border-bottom: 1px solid var(--border);
  font-size: 0.88rem;
}
.event-row:last-child { border-bottom: none; }
.event-row .when { color: var(--faint); font-size: 0.75rem; width: 34px; flex: none; }

.event-row .side-r { margin-left: auto; text-align: right; }
.event-row .side-r .team-cell { justify-content: flex-end; }

.evt {
  display: inline-grid; place-items: center;
  width: 18px; height: 18px;
  border-radius: 50%;
  font-size: 0.6rem;
  flex: none;
}

.evt.goal { background: var(--accent-soft); color: var(--accent); }
.evt.own_goal { background: var(--warning-soft); color: var(--warning); }
.evt.yellow { background: var(--warning); color: #04120a; }
.evt.red { background: var(--danger); color: #fff; }

/* ---------- Utilities ---------- */

.muted { color: var(--muted); }
.faint { color: var(--faint); }
.small { font-size: 0.82rem; }
.tiny { font-size: 0.72rem; }
.strong { font-weight: 700; }

.uppercase {
  display: block;
  text-transform: uppercase;
  letter-spacing: 1px;
  font-size: 0.78rem;
  font-weight: 700;
}

.hidden { display: none !important; }

.mt-0 { margin-top: 0 !important; }
.mt-2 { margin-top: 8px; }
.mt-3 { margin-top: 14px; }
.mt-4 { margin-top: 26px; }

.mb-0 { margin-bottom: 0 !important; }
.mb-2 { margin-bottom: 8px; }
.mb-3 { margin-bottom: 14px; }

.row-between { display: flex; align-items: center; justify-content: space-between; gap: 10px; }

.stack-2 > * + * { margin-top: 8px; }

.flex { display: flex; align-items: center; gap: 8px; }
.flex-wrap { flex-wrap: wrap; }

.grow { flex: 1; min-width: 0; }

.empty-note { color: var(--faint); padding: 24px 0; text-align: center; font-size: 0.9rem; }

.share-bar { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 12px; }

/* ---------- Responsive ---------- */

@media (min-width: 760px) {
  body { font-size: 16px; }
  .hero { padding: 44px 0 10px; }
  .hero h1 { font-size: clamp(2rem, 5vw, 3rem); }
  section.block { margin-top: 34px; }
  .site-footer { padding-bottom: 40px; }
}

/* ---------- Mobile nav ---------- */

#navToggle {
  display: none;
  background: none;
  border: 1px solid var(--border-strong);
  color: var(--text);
  border-radius: 8px;
  padding: 6px 10px;
  font-size: 1rem;
  cursor: pointer;
}

@media (max-width: 700px) {
  #navToggle { display: block; }
  .site-header .container { flex-wrap: wrap; height: auto; padding-top: 10px; padding-bottom: 10px; }
  .nav { display: none; width: 100%; flex-direction: column; margin-left: 0; margin-top: 8px; }
  .nav.open { display: flex; }
}
